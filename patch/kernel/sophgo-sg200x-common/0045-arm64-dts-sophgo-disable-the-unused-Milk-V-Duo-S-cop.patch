
---
diff --git a/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts b/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
index 129be66..2248dbf 100644
--- a/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
+++ b/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
@@ -238,9 +238,30 @@
 	status = "okay";
 };
 
+/*
+ * The SG2000 has a second, much smaller RISC-V core (a C906L) alongside the one
+ * running Linux. It is meant for real-time work with no operating system in the
+ * way - Milk-V's "Arduino on the Duo" runs sketches there, on FreeRTOS - and
+ * remoteproc is how Linux would load firmware onto it and start it.
+ *
+ * Nothing here uses it. Our bootloader deliberately ships no FreeRTOS image
+ * (see sophgo-sg200x_uboot.inc), we install no cvirtos.elf for remoteproc to
+ * load, and the core stays parked. What it did cost is the 2MiB at the top of RAM
+ * that the reserved-memory region holds for it, on a board with 512MiB total -
+ * and that region is reserved whether or not this node is enabled, so disabling
+ * the node alone would not give the memory back. Hence both.
+ *
+ * Deleting by label rather than by node name on purpose: the region is
+ * region@8fe00000 on riscv64 and region@9fe00000 on arm64, and /delete-node/ on a
+ * name that does not exist is silently accepted.
+ *
+ * To use the second core again: drop this block, restore the reserved region, and
+ * provide the firmware.
+ */
 &remoteproc {
-	status = "okay";
-};
+	/delete-property/ memory-region;
+	status = "disabled";
+};/delete-node/ &coprocessor_rtos;
 
 &saradc {
 	status = "okay";
-- 
