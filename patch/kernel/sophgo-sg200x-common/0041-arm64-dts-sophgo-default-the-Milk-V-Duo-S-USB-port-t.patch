From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Armbian <info@armbian.com>
Date: Thu, 30 Jul 2026 01:21:00 +0200
Subject: [PATCH] arm64: dts: sophgo: default the Milk-V Duo S USB port to host
 mode

Same change as the riscv64 Duo S dts, for the arm64 build of the same board:
host mode at probe with the role switch left in place, and the two Type-A
power lines driven as chained fixed regulators with their pads muxed to GPIO.
See the riscv64 patch for the reasoning.

The arm64 sg2000.dtsi reaches the SoC nodes by #including the riscv cv180x and
cv181x dtsi files, so the porta/portb/pinctrl/usbphy labels are all present,
but it does not pull in the pinmux bindings header - unlike the riscv
sg2000.dtsi - so this adds that include.

Signed-off-by: Armbian <info@armbian.com>
---
diff --git a/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts b/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
index 7d35db7..a2ed489 100644
--- a/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
+++ b/arch/arm64/boot/dts/sophgo/sg2000-milkv-duo-s.dts
@@ -2,6 +2,8 @@
 
 /dts-v1/;
 
+#include <dt-bindings/pinctrl/pinctrl-sg2000.h>
+
 #include "sg2000.dtsi"
 
 / {
@@ -27,6 +29,39 @@
 		stdout-path = "serial0:115200n8";
 	};
 
+	/*
+	 * Type-A port power. Two board lines have to be driven for the port to
+	 * come up, and neither is wired to anything the USB controller drives by
+	 * itself: USB_VBUS_EN, which per Milk-V's own pinmux table is XGPIOB_5
+	 * when muxed to function 3, and AUX0, which is XGPIOA_30. They are
+	 * chained so the regulator core brings AUX0 up first and takes it down
+	 * last, which is the order the vendor's userspace switcher uses.
+	 *
+	 * AUX0's exact role on this board is undocumented - the Duo 256M switcher
+	 * needs no GPIO at all, so it is specific to the Duo S - hence the plain
+	 * name rather than a guess at what it gates.
+	 */
+	reg_usb_aux0: regulator-usb-aux0 {
+		compatible = "regulator-fixed";
+		regulator-name = "usb-aux0";
+		gpio = <&porta 30 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb_aux0_cfg>;
+	};
+
+	reg_usb_vbus: regulator-usb-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&portb 5 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&reg_usb_aux0>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb_vbus_en_cfg>;
+	};
+
 	sound_card {
 		compatible = "simple-audio-card";
 		simple-audio-card,name = "Milk-V Duo S Built-in Audio";
@@ -222,11 +257,49 @@
 	status = "okay";
 };
 
+/*
+ * The pads are muxed from the regulator nodes rather than from &usb, so the
+ * mux is in place before the regulators drive the lines. The pin controller is
+ * strict and has no gpio_request_enable, and the GPIO banks declare no
+ * gpio-ranges, so requesting the line does not mux the pad by itself.
+ */
+&pinctrl {
+	usb_aux0_cfg: usb-aux0-cfg {
+		usb-aux0-pins {
+			pinmux = <PINMUX(PIN_AUX0, 3)>;
+		};
+	};
+
+	usb_vbus_en_cfg: usb-vbus-en-cfg {
+		usb-vbus-en-pins {
+			pinmux = <PINMUX(PIN_USB_VBUS_EN, 3)>;
+		};
+	};
+};
+
+/*
+ * Host by default: role-switch-default-mode is what dwc2_ovr_init() reads to
+ * force the controller into host mode at probe. The role switch stays
+ * registered, so /sys/class/usb_role/4340000.usb-role-switch/role still moves
+ * it to device at runtime, and phy_set_mode() flips the ID override in the
+ * PHY's syscon register on the way - the register a userspace switcher would
+ * otherwise poke through /dev/mem.
+ */
 &usb {
 	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "host";
 	status = "okay";
 };
 
+/*
+ * phy-supply is enabled by phy_power_on(), which dwc2 calls when it brings the
+ * controller up. That is not role-aware: VBUS stays on in device mode too.
+ */
+&usbphy {
+	phy-supply = <&reg_usb_vbus>;
+};
+
 &wdt {
 	status = "okay";
 };
-- 
2.34.1

