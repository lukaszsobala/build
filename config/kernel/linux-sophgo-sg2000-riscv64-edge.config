# Armbian kernel config for Sophgo SG2000/SG2002/CV1812H
# RISC-V mode - Single core T-Head C906
# Generated based on mainline 6.19 (edge) with Sophgo RISC-V support enabled
#
# This config is optimized for the limited resources of Milkv Duo S:
# - 512MB RAM
# - No GPU (use framebuffer)
# - Single core CPU
#

# Base configuration
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME=""
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# Module support (required for Armbian)
CONFIG_MODULES=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=y
CONFIG_MODULE_COMPRESS_NONE=y

# Optimize for size (limited RAM)
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Preemption for responsiveness
CONFIG_PREEMPT=y

# Basic kernel features
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y

CONFIG_EXPERT=y
CONFIG_KALLSYMS=y
CONFIG_PERF_EVENTS=y
CONFIG_BLK_DEV_INITRD=y

# RISC-V Platform
CONFIG_RISCV=y
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=1

# Sophgo SoC support - RISC-V
CONFIG_SOC_SOPHGO=y

# T-Head C906 errata and extensions
CONFIG_ERRATA_THEAD=y
CONFIG_ERRATA_THEAD_PBMT=y

# RISC-V extensions
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_V=y
CONFIG_FPU=y

# Kernel features
CONFIG_HZ_250=y

# Memory configuration
CONFIG_SPARSEMEM_VMEMMAP=y
CONFIG_COMPACTION=y
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=64

# Networking
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y

# Bluetooth support (for AIC8800 BT5)
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTSDIO=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y

# Block devices
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_ZRAM=y

# Device Tree
CONFIG_OF=y

# MTD support (for SPI flash)
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NOR=y

# SCSI support (for USB storage)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Network device support
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_TUN=m
CONFIG_VETH=m

# Sophgo Ethernet (STMMAC based)
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_DWC_QOS_ETH=y
CONFIG_DWMAC_GENERIC=y
CONFIG_DWMAC_SOPHGO=y

# PHY support
CONFIG_PHYLIB=y
CONFIG_FIXED_PHY=y

# USB networking
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y

# Input devices
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y

# Serial (8250 UART) - UART0-3 available
# UART0: Debug console (TX=pin8, RX=pin10)
# UART1-3: Available on GPIO headers
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_NR_UARTS=5
CONFIG_SERIAL_8250_RUNTIME_UARTS=5
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_OF_PLATFORM=y

# I2C support (I2C1-4 available, I2C2/3 used by cameras)
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_MUX=y

# SPI support
CONFIG_SPI=y
CONFIG_SPI_SPIDEV=y
CONFIG_SPI_DESIGNWARE=y
CONFIG_SPI_DW_MMIO=y

# GPIO support
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_DWAPB=y

# Pin control - Sophgo
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SOPHGO_COMMON=y
CONFIG_PINCTRL_SOPHGO_CV18XX_OPS=y
CONFIG_PINCTRL_SOPHGO_CV1800B=y
CONFIG_PINCTRL_SOPHGO_CV1812H=y
CONFIG_PINCTRL_SOPHGO_SG2000=y
CONFIG_PINCTRL_SOPHGO_SG2002=y

# Clock driver - Sophgo
CONFIG_COMMON_CLK=y
CONFIG_CLK_SOPHGO_CV1800=y

# Power management
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y

# Power supply
CONFIG_POWER_SUPPLY=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_RESTART=y

# Hardware monitoring
CONFIG_HWMON=y

# Thermal
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y

# MFD
CONFIG_MFD_SYSCON=y

# RTC - Sophgo CV1800 (with alarm/wakeup support)
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CV1800=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_SYSTOHC=y

# DMA - Sophgo
CONFIG_DMADEVICES=y
CONFIG_DW_AXI_DMAC=y
CONFIG_SOPHGO_CV1800B_DMAMUX=y

# Mailbox - Sophgo
CONFIG_MAILBOX=y
CONFIG_CV1800_MBOX=y

# SoC drivers - Sophgo
CONFIG_SOPHGO_CV1800_RTCSYS=y

# MMC/SD/SDIO/eMMC support
# SD card on mmcblk0, eMMC (optional) on mmcblk1
# SDIO needed for AIC8800 WiFi
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_CQHCI=y
CONFIG_SDIO_UART=m
# eMMC boot partition access
CONFIG_MMC_BLOCK_MINORS=32

# USB support
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y

# USB Host
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y

# USB DWC2 (SG2000 uses this)
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y

# USB Gadget (Type-C port supports NCM network)
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_ECM=y
CONFIG_USB_CONFIGFS_F_NCM=y
CONFIG_USB_CONFIGFS_F_RNDIS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_ETH=m
CONFIG_USB_ETH_RNDIS=y

# USB Storage
CONFIG_USB_STORAGE=y

# USB PHY
CONFIG_USB_PHY=y
CONFIG_USB_GPIO_VBUS=y

# IIO - ADC
CONFIG_IIO=y
CONFIG_SOPHGO_CV1800B_ADC=y

# Extcon
CONFIG_EXTCON=y

# PWM - Sophgo CV1800 (PWM1-13 available on GPIO headers)
CONFIG_PWM=y
CONFIG_PWM_SYSFS=y
# CONFIG_PWM_SOPHGO_CV1800 is not set (not yet mainlined, use GPIO PWM)

# Watchdog
CONFIG_WATCHDOG=y

# Graphics - Simple framebuffer (no GPU)
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y

# Media/V4L2 support (for MIPI CSI cameras)
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_VIDEO_V4L2=m
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_MEM2MEM_DEINTERLACE=m

# Camera sensor drivers
# J1 connector: CAM-GC2083 (Duo/Duo256M compatible)
# J2 connector: OV5647 (Raspberry Pi compatible)
CONFIG_VIDEO_GC2145=m
CONFIG_VIDEO_GC2083=m
CONFIG_VIDEO_OV5647=m

# MIPI CSI receiver (if available in mainline)
# CONFIG_VIDEO_SOPHGO_CV1800_CSI is not set

# DRM (for potential future MIPI DSI support)
CONFIG_DRM=m
CONFIG_DRM_PANEL=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_PANEL_SIMPLE=m

# Sound support (audio output via GPIO header)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_COMPRESS_OFFLOAD=m
CONFIG_SND_SOC=y
CONFIG_SND_SOC_GENERIC_DMAENGINE_PCM=y
CONFIG_SND_SIMPLE_CARD=m
CONFIG_SND_SIMPLE_CARD_UTILS=m

# LED support (Blue LED on XGPIOA[29] = GPIO 509)
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_PWM=m
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_NETDEV=y

# File systems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y

# Pseudo filesystems
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# NFS
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y
CONFIG_ROOT_NFS=y

# NLS
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Security
CONFIG_KEYS=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y

# Crypto
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_ZSTD=y

# Kernel hacking
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_FRAME_POINTER=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y

# Memory debugging (disabled for production)
# CONFIG_DEBUG_PAGEALLOC is not set
# CONFIG_DEBUG_OBJECTS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_KASAN is not set

# RISC-V SBI
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_SBI_CONSOLE=y
