# Milk-V Duo S (Sophgo SG2000) - RISC-V mode
# T-Head C906 @ 1GHz, 512MB LPDDR3, microSD, 100M Ethernet, USB-C OTG, USB-A,
# AIC8800D80 Wi-Fi 6 + BT 5, 26-pin + 14-pin GPIO headers.
#
# The SG2000 has both a C906 RISC-V core and a Cortex-A53. Which one boots Linux
# is decided by the FSBL inside fip.bin, so the choice is made by writing this
# image (RISC-V) or the milkv-duos-arm one, not by a switch on the board.
#
# The bootloader is built from source, same as the ARM variant; BOOTCONFIG comes
# from the family include. See
# config/sources/families/include/sophgo-sg200x_uboot.inc.
#
# https://milkv.io/duo-s
BOARD_NAME="Milk-V Duo S"
BOARDFAMILY="sophgo-sg200x-riscv64"
BOARD_MAINTAINER="lukaszsobala"
KERNEL_TARGET="edge,bleedingedge"
BOOT_FDT_FILE="sophgo/sg2000-milkv-duo-s.dtb"
SERIALCON="ttyS0"
SRC_CMDLINE="earlycon=sbi console=ttyS0,115200"

# 512MB of RAM does not go far; keep the userspace lean.
PACKAGE_LIST_BOARD_REMOVE="snapd cloud-init"

enable_extension "sophgo-aic8800"

function post_family_tweaks__milkv_duos_riscv() {
	display_alert "Milk-V Duo S" "applying RISC-V board tweaks" "info"

	# zram matters a lot more than usual at 512MB. The stock 50% gives ~240MB of
	# swap; 100% gives a 512MB device while MEM_LIMIT_PERCENTAGE stays at its 50%
	# default, so zram may still only occupy 256MB of physical RAM. That is the
	# overcommit setup the shipped config file points at.
	#
	# The variable is ZRAM_PERCENTAGE and it ships commented out, so the pattern
	# has to tolerate the leading "# " - an earlier version anchored on
	# ^PERCENTAGE= and silently matched nothing for every build.
	declare zram_conf="${SDCARD}/etc/default/armbian-zram-config"
	if [[ -f "${zram_conf}" ]]; then
		sed -i 's/^#\?\s*ZRAM_PERCENTAGE=.*/ZRAM_PERCENTAGE=100/' "${zram_conf}"
		grep -q '^ZRAM_PERCENTAGE=100$' "${zram_conf}" ||
			exit_with_error "failed to set ZRAM_PERCENTAGE" "${zram_conf}"
	fi
}
