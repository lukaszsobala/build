[Unit]
Description=AIC8800 Bluetooth (attach HCI H4 on the SG200x Bluetooth UART)
Documentation=man:hciattach(1)
# aic8800_bsp uploads the Bluetooth patch as part of chip init; until it has run
# the UART is silent. modules-load.d brings it in.
After=systemd-modules-load.service
Before=bluetooth.service
Wants=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/aic8800-bluetooth

[Install]
WantedBy=multi-user.target
